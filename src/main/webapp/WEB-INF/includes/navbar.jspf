<%--
    navbar.jspf — barra de navegación compartida por todas las vistas.
    Se incluye con: <%@ include file="/WEB-INF/includes/navbar.jspf" %>
--%>
<c:set var="esCliente" value="false"/>
<c:set var="esAgente" value="false"/>

<c:forEach var="rol" items="${sessionScope.roles}">
    <c:if test="${rol.nombre eq 'CLIENTE'}">
        <c:set var="esCliente" value="true"/>
    </c:if>
    <c:if test="${rol.nombre eq 'AGENTE'}">
        <c:set var="esAgente" value="true"/>
    </c:if>
</c:forEach>

<nav class="navbar navbar-expand-lg navbar-inmo">

    <input type="checkbox" id="menu-nav" class="navbar-checkbox" aria-hidden="true">

    <div class="container">

        <a class="navbar-brand" href="${pageContext.request.contextPath}/">Inmobiliaria</a>

        <label for="menu-nav" class="navbar-toggler-solo" aria-label="Abrir el menú de navegación">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <div class="navbar-menu-colapsable" id="menuPrincipal">

            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/propiedades?operacion=arriendo">Arriendo</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/propiedades?operacion=venta">Venta</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/#catalogo">Catálogo</a>
                </li>
                <c:if test="${esAgente}">
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/inmobiliaria/propiedades/formulario">Publicar propiedad</a>
                </li>
                </c:if>
            </ul>

            <c:choose>
                <c:when test="${not empty sessionScope.usuarioId}">
                    <div class="d-flex flex-column flex-lg-row gap-2">
                        <c:choose>
                            <c:when test="${esAgente}">
                                <a class="btn btn-contorno"
                                   href="${pageContext.request.contextPath}/inmobiliaria/dashboard">
                                    Mi panel
                                </a>
                            </c:when>
                            <c:when test="${esCliente}">
                                <a class="btn btn-contorno"
                                   href="${pageContext.request.contextPath}/cliente/dashboard">
                                    Mi panel
                                </a>
                            </c:when>
                            <c:otherwise>
                                <a class="btn btn-contorno"
                                   href="${pageContext.request.contextPath}/admin/dashboard">
                                    Mi panel
                                </a>
                            </c:otherwise>
                        </c:choose>
                        <a class="btn btn-marca"
                           href="${pageContext.request.contextPath}/logout">
                            Cerrar sesión
                        </a>
                    </div>
                </c:when>
                <c:otherwise>
                    <div class="d-flex flex-column flex-lg-row gap-2">
                        <a class="btn btn-contorno" href="${pageContext.request.contextPath}/login">Ingresar</a>
                        <a class="btn btn-marca" href="${pageContext.request.contextPath}/registro">Crear cuenta</a>
                    </div>
                </c:otherwise>
            </c:choose>

        </div>
    </div>
</nav>
