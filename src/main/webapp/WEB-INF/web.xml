<?xml version="1.0" encoding="UTF-8"?>

<!--
    Descriptor Servlet 3.1 — coincide exactamente con Tomcat 8.5.x,
    que es lo que usa el equipo (confirmado: Tomcat/8.5.96).

    Historial: primero estaba en el DTD 2.3 (desactivaba el
    Expression Language en las JSP: ${...} se imprimía literal en
    vez de evaluarse). Se subió a 4.0 para arreglar eso, pero 4.0
    es la versión de Servlet 4.0 (Tomcat 9), no la que corre este
    equipo. Bajado a 3.1, que sí es exacto para Tomcat 8.5 y ya
    soporta el-ignored (existe desde Servlet 2.4).
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Inmobiliaria</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <el-ignored>false</el-ignored>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

</web-app>
